  "plan": {
    "schema": "greenfuel.task-plan/v1",
    "title": "Jurisdiction-local evidence store design",
    "request": "Design a jurisdiction-local evidence store for delivery measurement evidence. Architect proposes, security reviewer assesses residency, critic challenges, orchestrator consolidates. Do not provision Azure resources.",
    "objective": "Produce a design proposal, a residency/isolation/tamper assessment, an adversarial challenge and a consolidated report. Phase 0: documents only, nothing provisioned.",
    "requirements": [
      "FR-001",
      "FR-006",
      "SEC-001",
      "SEC-002",
      "SEC-006",
      "SEC-008"
    ],
    "constraints": [
      "HC-01",
      "HC-02",
      "HC-07",
      "HC-08",
      "HC-11",
      "HC-12"
    ],
    "risks": [
      {
        "id": "RK-1",
        "text": "The proposal may treat an Azure region choice as proof of port-jurisdiction residency.",
        "mitigation": "T2 and T3 check against SEC-001 and HC-01; the legal meaning of the jurisdiction (D-009) is left as an open decision, not assumed."
      },
      {
        "id": "RK-2",
        "text": "The proposal may invent Azure SKUs, prices, availability or compliance figures.",
        "mitigation": "A file-not-contains test rejects placeholders and T3 challenges unsourced figures (HC-12); unknowns must be marked ASSUMPTION or TBD."
      },
      {
        "id": "RK-3",
        "text": "A design might imply resource creation or application code, breaching Phase 0.",
        "mitigation": "Only documentation artifacts are allowed; the plan has no P2 or higher operations (HC-11)."
      },
      {
        "id": "RK-4",
        "text": "Review tasks may agree without independent challenge, or the consolidation may relay unverified claims as fact.",
        "mitigation": "T3 must end with a Verdict and T4 must list unverified claims and human-only decisions separately."
      }
    ],
    "tasks": [
      {
        "id": "T1",
        "title": "Propose evidence store design",
        "objective": "Write a design proposal for a jurisdiction-local evidence store for delivery measurement evidence covering residency, per-shipowner isolation, append-only tamper evidence and offline edge reconciliation. No resources are provisioned.",
        "requirements": [
          "FR-001",
          "FR-006",
          "SEC-001",
          "SEC-008"
        ],
        "agent": "principal-architect",
        "inputContext": [
