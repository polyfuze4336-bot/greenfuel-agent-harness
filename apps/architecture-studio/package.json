{
  "name": "architecture-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Architecture Decision Studio: reads the greenfuel-agent-harness repository, supports one-at-a-time decision review through reviewed pull requests, and computes build readiness. Not the bunkering platform.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3100",
    "build": "next build",
    "start": "next start --hostname localhost --port 3100",
    "start:synced": "node scripts/start-synced.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"checks/*.check.ts\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "jszip": "3.10.2",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pptxgenjs": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
