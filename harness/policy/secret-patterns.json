{
  "version": 1,
  "description": "Single source of secret-shaped patterns. 'repository' patterns fail validation if found in tracked files or MCP configuration. 'redaction' patterns are replaced with [REDACTED] in tool output before it reaches the model or a log. Patterns are heuristics: they reduce, not remove, the chance of a leak.",
  "repository": [
    "-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "AccountKey=[A-Za-z0-9+/=]{20,}",
    "\\bghp_[A-Za-z0-9]{30,}",
    "\\bgithub_pat_[A-Za-z0-9_]{30,}",
    "\\bAKIA[0-9A-Z]{16}\\b",
    "\\bxox[baprs]-[A-Za-z0-9-]{10,}",
    "\\beyJ[A-Za-z0-9_-]{20,}\\.eyJ[A-Za-z0-9_-]{10,}",
    "[?&]sig=[A-Za-z0-9%+/=]{20,}"
  ],
  "redaction": [
    "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?(-----END [A-Z ]*PRIVATE KEY-----|$)",
    "\\bgh[pousr]_[A-Za-z0-9]{30,}",
    "\\bgithub_pat_[A-Za-z0-9_]{30,}",
    "\\bAKIA[0-9A-Z]{16}\\b",
    "\\bxox[baprs]-[A-Za-z0-9-]{10,}",
    "\\beyJ[A-Za-z0-9_-]{20,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{5,}",
    "AccountKey=[A-Za-z0-9+/=]{20,}",
    "(?<=[?&;]sig=)[A-Za-z0-9%+/=]{20,}",
    "(?<=bearer\\s)[A-Za-z0-9._~+/=-]{16,}",
    "(?<=(?:api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|password|passwd|secret)\\s*[=:]\\s*[\"']?)[^\\s\"'&;,]{8,}"
  ]
}
